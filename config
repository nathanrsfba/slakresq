# Slackware version
SLACKVERSION=15.0

# Archtecture
ARCH=x86_64
#ARCH=x86

# Which disksets to use in the core bundle
CORE_DISKSETS="a"

# Packages out of ap or l that are needed for the Linux Live Kit build script.
# Use this if your core diskset doesn't include ap and l
SUPPORT_PKGS="squashfs-tools lzo lz4 cdrtools"

# The following declare the bundles to create, and what disksets go in them.
BUNDLE[10-console]="ap f l n y"
BUNDLE[20-dev]="d e tcl"
BUNDLE[90-x11]="x xap xfce"
BUNDLE[95-kde]="kde"

# If a bundle doesn't specify any disksets, no disksets will be extracted for
# that bundle. In this event, it is assumed the files for the bundle will be
# populated in trees/ beforehand.
BUNDLE[99-patches]=""

# If you want to include the kernel source and/or TeX, uncomment the following:
# BUNDLE[30-ksrc]="k"
# BUNDLE[30-tex]="t"

# Third-party packages
# Supported sources:
#   alien: AlienBob package repo. Simpy specfiy the name of the package
#   extra: Packages from the Slackware extras directory. If it's a file,
#     provide the package name. If it lives in a subdirectory, specify the
#     directory, suffixed by a /
#   http, https, or ftp: A generic URL to a file or directory. If a directory,
#     download all package files in the given path

# SBO Tools: A ports-like interface to slackbuilds.org
#EXTRA[11-sbotools]="https://pink-mist.github.io/sbotools/downloads/sbotools-2.7-noarch-1_SBo.tgz"

# Cinnmon destop environment
#EXTRA[95-cinnamon]="https://slackware.uk/csb/$SLACKVERSION/$ARCH/"

# LibreOffice
#EXTRA[21-jdk]="alien:jdk11"
#EXTRA[91-libreoffice]="alien:libreoffice" # Requires jdk

# Chromium
#EXTRA[91-chromium]="alien:chromium"

# TigerVNC
#EXTRA[11-vnc]="extra:fltk/ extra:tigervnc/"

# Samba 4.22
#EXTRA[21-samba]="extra:samba"

# Automatically download the install disksets
FETCHINSTALL=1

# Automatically download updates when building
FETCHUPDATES=1

# Install updates before building
INSTALLUPDATES=1

# FTP app to use. If for some reason lftp doesn't like your setup, try ncftp
FTP=lftp
#FTP=ncftp

# Slackware mirror to download files from. Should point to the main slackware
# directory with versions

MIRROR="ftp://ftp.slackware.com/pub/slackware/"

