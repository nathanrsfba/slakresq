type=patch
tree=90-x11
path=etc/X11/xdm/Xsetup_0
-----
--- trees/90-x11/etc/X11/xdm/Xsetup_0	2007-02-13 17:22:23.000000000 -0800
+++ trees/99-patches/etc/X11/xdm/Xsetup_0	2023-07-23 15:26:08.297711608 -0700
@@ -2,6 +2,23 @@
 # $Xorg: Xsetup_0,v 1.3 2000/08/17 19:54:17 cpqbld Exp $
 #xconsole -geometry 480x130-0-0 -daemon -notify -verbose -fn fixed -exitOnFail
 
+# Set up some buttons in the corner
+buttons () {
+	xmessage -buttons Shutdown,Restart,Console '' &
+	PID=$!
+
+	echo $PID > /var/run/buttons.pid
+	wait $PID
+
+	case $? in
+		101) /sbin/shutdown -h now ;;
+		102) /sbin/shutdown -r now ;;
+		103) /sbin/telinit 3 ;;
+	esac
+}
+
+buttons &
+
 # Fix backspace problem in login box:
 sysmodmap=/etc/X11/xinit/.Xmodmap
 if [ -f $sysmodmap ]; then
